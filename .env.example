PORT=3000
EIDOVA_BASE_URL=http://localhost:3000
EIDOVA_STATE_DIR=.open-design/state
# Optional custom catalog/content paths:
# EIDOVA_ASSETS_DIR=/absolute/path/to/assets/registry
# EIDOVA_CONTENT_LIBRARY=/absolute/path/to/content/library.json
# Private local stdio only: directory containing authorized numbered captures.
# EIDOVA_PRIVATE_ARCHIVE=/absolute/path/to/private/archive
# Optional private stdio workspace key (43-128 base64url characters):
# EIDOVA_WORKSPACE_KEY=
# Vercel deployment: link a PRIVATE Blob store; Vercel sets this secret.
# BLOB_READ_WRITE_TOKEN=

# Independent persistent team backend (Node 24+; not a Vercel function).
# EIDOVA_STUDIO_DB=.eidova/studio.sqlite
# EIDOVA_STUDIO_PORT=3210
# EIDOVA_STUDIO_HOST=127.0.0.1
# EIDOVA_STUDIO_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Opt-in private stdio team tools: node dist/stdio.js --studio
# EIDOVA_STUDIO_URL=http://127.0.0.1:3210
# EIDOVA_STUDIO_KEY=

# Required for remote Studio binding or an externally reachable reverse proxy.
# At least 32 characters; distribute privately to workspace creators.
# EIDOVA_STUDIO_REGISTRATION_KEY=
