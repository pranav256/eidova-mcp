PORT=3000
OPEN_DESIGN_BASE_URL=http://localhost:3000
OPEN_DESIGN_STATE_DIR=.open-design/state
# Optional custom catalog/content paths:
# OPEN_DESIGN_ASSETS_DIR=/absolute/path/to/assets/registry
# OPEN_DESIGN_CONTENT_LIBRARY=/absolute/path/to/content/library.json
# Optional private stdio workspace key (43-128 base64url characters):
# OPEN_DESIGN_WORKSPACE_KEY=
# Vercel deployment: link a PRIVATE Blob store; Vercel sets this secret.
# BLOB_READ_WRITE_TOKEN=
