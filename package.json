{
  "name": "eidova-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.pranav256/eidova",
  "bin": {
    "eidova-mcp": "dist/stdio.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "assets/registry",
    "assets/LICENSE",
    "assets/TABLER-LICENSE",
    "assets/UPSTREAM.json",
    "content",
    "README.md",
    "LICENSE",
    "NOTICE",
    "server.json",
    "vendor/upstream/LICENSE",
    "vendor/upstream/provenance.json",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "type": "module",
  "description": "Independent open-source design tools with a local component registry",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-systems",
    "react",
    "shadcn",
    "accessibility",
    "eidova"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "stdio": "tsx src/stdio.ts",
    "stdio:private": "node scripts/start-private.mjs",
    "build": "tsup src/index.ts src/main.ts src/stdio.ts --format esm --platform node --target node22 --dts --clean",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "audit:themes": "tsx scripts/audit-themes.ts",
    "sync:previews": "tsx scripts/sync-website-previews.ts ../eidova-website",
    "prepack": "npm run check && npm run build",
    "content:import": "tsx scripts/import-content.ts",
    "build:upstream": "node scripts/build-upstream.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:private": "node scripts/smoke-private.mjs",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "verify:consumers": "node scripts/verify-consumers.mjs",
    "review:website": "node scripts/review-site.mjs",
    "resources:import": "node scripts/import-resources.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.151",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vercel/blob": "^2.8.2",
    "axe-core": "4.14.0",
    "express": "5.1.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.19.0",
    "esbuild": "^0.25.12",
    "tsup": "8.5.0",
    "tsx": "4.20.6"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "@vercel/cli-config": "0.3.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pranav256/eidova-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pranav256/eidova-mcp/issues"
  },
  "homepage": "https://eidova.vercel.app"
}
